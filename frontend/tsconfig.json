{
  "compilerOptions": {
    "jsx": "preserve",
    "module": "NodeNext",
    "target": "ESNext",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "allowJs": true,
    "moduleResolution": "nodenext",
    "strictNullChecks": true,
    "isolatedModules": true
  },
  "include": ["vite.config.ts", "src/**/*"],
  "exclude": ["**/*.spec.ts"]
}